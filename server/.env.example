# Env template for structure-lens server (v15)
PORT=80
# Primary AI channel (Deepseek BYOK direct)
AI_PROVIDER_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
AI_PROVIDER_API_KEY=<deepseek token, keep local only, never commit or print>
AI_PROVIDER_MODEL=Deepseek-v4-flash
# Fallback AI channel (Tencent cloudbase gateway, hy3)
AI_FALLBACK_BASE_URL=https://xiaochengxu-d1gzvnftu21ecf29e.api.tcloudbasegateway.com/v1/ai/cloudbase
AI_FALLBACK_API_KEY=<hy3 jwt, keep local only, never commit or print>
AI_FALLBACK_MODEL=hy3
# MySQL (WeChat cloudrun MySQL / CynosDB). Leave MYSQL_HOST empty -> in-memory (local scaffold only)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=structure_lens
