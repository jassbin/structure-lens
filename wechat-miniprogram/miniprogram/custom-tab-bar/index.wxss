.tab-bar {
  display: flex;
  height: calc(110rpx + constant(safe-area-inset-bottom));
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(17, 21, 30, 0.92);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255,255,255,0.07);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.35);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 14rpx;
  color: var(--text-3);
  transition: color 0.2s;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  transition: transform 0.2s;
}

.tab-item.active .tab-icon {
  transform: translateY(-2rpx) scale(1.1);
  filter: drop-shadow(0 4rpx 10rpx rgba(226,198,111,0.5));
}


.tab-item.active {
  color: var(--accent);
}
