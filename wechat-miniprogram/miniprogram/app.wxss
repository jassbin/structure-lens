/* 解忧果 全局设计系统：深色 + 金色微光
   字体规范：正文用 -apple-system/PingFang；金句/大标题/收尾原则用 serif（--font-display）强调
   颜色语义：金=核心观点/主行动；蓝=客观结构/方法与机制；橙=风险/成本；绿=已验证/可行动；红=陷阱/反面
   角标：数字方块（mod-no/step-no/check-no）=步骤顺序；胶囊 badge=定性标签 */
page {
  --bg: #0b0e14;
  --bg-elev: #11151e;
  --bg-card: #161b26;
  --bg-card-2: #1d2331;
  --bg-card-3: #242b3b;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(226, 194, 106, 0.35);
  --text-1: #f0f2f5;
  --text-2: #a8b1bf;
  --text-3: #6d7686;
  --accent: #e4c66f;
  --accent-strong: #d4af37;
  --accent-soft: rgba(226, 194, 106, 0.14);
  --danger: #ef6a6a;
  --ok: #63c995;
  --warn-c: #e0a45e;
  --info: #7db0ff;
  --font-display: "Songti SC", "STSong", "SimSun", serif;

  background:
    radial-gradient(120% 60% at 50% 0%, rgba(226, 194, 106, 0.10), rgba(13, 16, 23, 0) 55%),
    radial-gradient(120% 80% at 90% 30%, rgba(122, 176, 255, 0.06), rgba(13, 16, 23, 0) 60%),
    var(--bg);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.66;
}

/* 通用卡片：毛玻璃 + 细描边 + 悬浮感 */
.card {
  background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015)), var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.30);
}

.card-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); margin-bottom: 12rpx; }
.card-sub { font-size: 24rpx; color: var(--text-3); margin-bottom: 16rpx; }
.text-muted { color: var(--text-3); }
.text-2 { color: var(--text-2); }
.mb { margin-bottom: 12rpx; }

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  background: var(--bg-card-3);
  color: var(--text-2);
  border: 1rpx solid rgba(255,255,255,0.10);
}
.badge-strong { background: rgba(226, 194, 106, 0.14); color: var(--accent); border-color: rgba(226, 194, 106, 0.38); }
.badge-danger { background: rgba(230, 102, 102, 0.14); color: var(--danger); border-color: rgba(230, 102, 102, 0.38); }
.badge-warn { background: rgba(232, 164, 94, 0.14); color: var(--warn-c); border-color: rgba(232, 164, 94, 0.38); }
.badge-ok { background: rgba(99, 201, 149, 0.14); color: var(--ok); border-color: rgba(99, 201, 149, 0.38); }
.badge-info { background: rgba(125, 176, 255, 0.14); color: var(--info); border-color: rgba(125, 176, 255, 0.38); }

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f0d078, #c9a227);
  color: #14181f;
  font-size: 32rpx;
  font-weight: 800;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(212, 175, 55, 0.25);
}
.btn::after { border: none; }
.btn:active { transform: scale(0.985); opacity: 0.92; }
.btn.disabled { opacity: 0.38; box-shadow: none; }

.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  box-shadow: none;
}

/* 文本输入 */
.input {
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

/* item7: allow long-press text selection everywhere */
view, text { -webkit-user-select: text; user-select: text; }
