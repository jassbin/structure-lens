/* 解忧果 全局设计系统：深色 + 金色微光
   字体规范：正文用 -apple-system/PingFang；金句/大标题/收尾原则用 serif（--font-display）强调
   颜色语义：金=核心观点/主行动；蓝=客观结构/方法与机制；橙=风险/成本；绿=已验证/可行动；红=陷阱/反面
   角标：数字方块（mod-no/step-no/check-no）=步骤顺序；胶囊 badge=定性标签 */
page {
  --bg: #0b0e14;
  --bg-elev: #11151e;
  --bg-card: #161b26;
  --bg-card-2: #1d2331;
  --bg-card-3: #242b3b;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(226, 194, 106, 0.35);
  --text-1: #f0f2f5;
  --text-2: #a8b1bf;
  --text-3: #6d7686;
  --accent: #e4c66f;
  --accent-strong: #d4af37;
  --accent-soft: rgba(226, 194, 106, 0.14);
  --danger: #ef6a6a;
  --ok: #63c995;
  --warn-c: #e0a45e;
  --info: #7db0ff;
  --font-display: "Songti SC", "STSong", "SimSun", serif;

  background:
    radial-gradient(120% 60% at 50% 0%, rgba(226, 194, 106, 0.10), rgba(13, 16, 23, 0) 55%),
    radial-gradient(120% 80% at 90% 30%, rgba(122, 176, 255, 0.06), rgba(13, 16, 23, 0) 60%),
    var(--bg);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.66;
}

/* 通用卡片：毛玻璃 + 细描边 + 悬浮感 */
.card {
  background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.015)), var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.30);
}

.card-title { font-size: 30rpx; font-weight: 700; color: var(--text-1); margin-bottom: 12rpx; }
.card-sub { font-size: 24rpx; color: var(--text-3); margin-bottom: 16rpx; }
.text-muted { color: var(--text-3); }
.text-2 { color: var(--text-2); }
.mb { margin-bottom: 12rpx; }

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  background: var(--bg-card-3);
  color: var(--text-2);
  border: 1rpx solid rgba(255,255,255,0.10);
}
.badge-strong { background: rgba(226, 194, 106, 0.14); color: var(--accent); border-color: rgba(226, 194, 106, 0.38); }
.badge-danger { background: rgba(230, 102, 102, 0.14); color: var(--danger); border-color: rgba(230, 102, 102, 0.38); }
.badge-warn { background: rgba(232, 164, 94, 0.14); color: var(--warn-c); border-color: rgba(232, 164, 94, 0.38); }
.badge-ok { background: rgba(99, 201, 149, 0.14); color: var(--ok); border-color: rgba(99, 201, 149, 0.38); }
.badge-info { background: rgba(125, 176, 255, 0.14); color: var(--info); border-color: rgba(125, 176, 255, 0.38); }

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f0d078, #c9a227);
  color: #14181f;
  font-size: 32rpx;
  font-weight: 800;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(212, 175, 55, 0.25);
}
.btn::after { border: none; }
.btn:active { transform: scale(0.985); opacity: 0.92; }
.btn.disabled { opacity: 0.38; box-shadow: none; }

.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  box-shadow: none;
}

/* 文本输入 */
.input {
  background: var(--bg-card-2);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

/* item7: allow long-press text selection everywhere */
view, text { -webkit-user-select: text; user-select: text; }


/* ===== 设计系统（三页统一 2026-09-17） =====
 * 颜色语义：accent金=重点/行动 · info蓝=说明信息 · ok绿=正常/通过 · warn橙=风险/偏软 · danger红=红线/否定
 * 字号语义：hero标题34~40 · 卡/小节标题28~30 · 正文强调26 · 正文24 · 辅助20~22
 * 符号语义：? 问号=解释注释 · ○/◦/✓ = 阶段未到/进行/完成 · › = 可进入 · ▾ = 可展开
 * 弹窗语义：操作/追问=底部抽屉（遮罩+金色标题） · 问号解释=锚定气泡
 */
.tip-mask { position: fixed; inset: 0; background: rgba(4,6,12,0.35); z-index: 900; }
.tip-bubble { position: fixed; width: 82%; max-width: 660rpx; box-sizing: border-box; padding: 26rpx 28rpx 22rpx; background: linear-gradient(180deg,#20293a,#161b26); border: 1rpx solid rgba(226,194,106,0.35); border-radius: 20rpx; box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.5); max-height: 60vh; overflow-y: auto; }
.tip-title { font-size: 27rpx; font-weight: 800; color: var(--accent); margin-bottom: 12rpx; }
.tip-text { font-size: 25rpx; line-height: 1.75; color: var(--text-2); }
.tip-done { margin-top: 22rpx; text-align: center; font-size: 25rpx; font-weight: 700; color: var(--accent); padding: 16rpx; border-top: 1rpx solid rgba(255,255,255,0.08); }
.tip-arrow { position: absolute; width: 0; height: 0; border: 12rpx solid transparent; margin-left: -12rpx; }
.tip-arrow.above { bottom: -24rpx; border-top-color: #20293a; }
.tip-arrow.below { top: -24rpx; border-bottom-color: #20293a; }

.tip-btn { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-left: 12rpx; border-radius: 50%; border: 1rpx solid rgba(255,255,255,0.22); color: var(--text-3); font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.03); }
.tip-btn:active { color: var(--accent); border-color: var(--accent); }

.mini-btn, .ghost-btn { width: 100%; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1.5; border-radius: 999rpx; font-size: 26rpx; }
.mini-btn { height: 84rpx; background: linear-gradient(135deg, rgba(240,208,120,0.20), rgba(212,175,55,0.08)); color: var(--accent); border: 1rpx solid rgba(226,194,106,0.5); font-weight: 700; }
.ghost-btn { height: 84rpx; background: transparent; color: var(--text-2); border: 1rpx solid rgba(255,255,255,0.12); font-weight: 600; }
.mini-btn::after, .ghost-btn::after { border: none; }

.sec-ask { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx dashed rgba(255,255,255,0.10); display: flex; justify-content: flex-start; }
.ask-btn { display: inline-flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; color: var(--accent); border: 1rpx solid rgba(226,194,106,0.45); border-radius: 999rpx; padding: 12rpx 26rpx; background: rgba(226,194,106,0.08); line-height: 1.4; }
.ask-btn:active { opacity: 0.75; }

/* 追问重算浮条：不打扰看正文，右下角安静提示（report/action/method 三页共用） */
.debate-float {
  position: fixed;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 48rpx);
  z-index: 960;
  display: flex;
  align-items: center;
  gap: 14rpx;
  max-width: 70vw;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(19, 24, 33, 0.94);
  border: 1rpx solid rgba(226, 194, 106, 0.35);
  box-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.45);
  font-size: 23rpx;
  font-weight: 600;
  color: var(--accent);
}
.float-ring {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(226, 194, 106, 0.22);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: float-spin 0.9s linear infinite;
}
@keyframes float-spin { to { transform: rotate(360deg); } }

.modal-mask { position: fixed; inset: 0; background: rgba(4,6,12,0.58); backdrop-filter: blur(6rpx); z-index: 950; display: flex; align-items: flex-end; }
.modal { width: 100%; box-sizing: border-box; background: linear-gradient(180deg,#20293a,#161b26); border: 1rpx solid rgba(226,194,106,0.30); border-bottom: none; border-radius: 30rpx 30rpx 0 0; padding: 34rpx 32rpx 44rpx; box-shadow: 0 -20rpx 60rpx rgba(0,0,0,0.5); }
.modal-title { font-size: 30rpx; font-weight: 800; color: var(--accent); margin-bottom: 6rpx; }
.modal-sub { margin-top: 8rpx; font-size: 23rpx; color: var(--text-2); }
.modal-input { width: 100%; box-sizing: border-box; margin-top: 22rpx; min-height: 150rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.14); border-radius: 18rpx; padding: 20rpx 22rpx; font-size: 26rpx; color: var(--text-1); line-height: 1.6; }
.modal-input:focus { border-color: rgba(226,194,106,0.5); }
.modal .btn { width: 100%; margin-top: 26rpx; flex: none; }
.modal .share-tip { font-size: 24rpx; color: var(--text-2); margin-bottom: 24rpx; }

/* ===== 三页链路条（2026-09-17） =====
 * 看穿(结构) -> 找到缝(行动) -> 动起来(规划)：三页共用同一条时间线。 */
.chain-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 18rpx 12rpx;
  background: var(--bg-card-2);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 20rpx;
}
.chain-node { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.chain-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.18);
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.chain-node.active .chain-dot {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(226,194,106,0.14);
  box-shadow: 0 0 16rpx rgba(226,194,106,0.30);
}
.chain-node.passed .chain-dot { border-color: rgba(226,194,106,0.5); color: var(--accent); }
.chain-label { margin-top: 8rpx; font-size: 21rpx; color: var(--text-3); }
.chain-node.active .chain-label { color: var(--accent); font-weight: 700; }
.chain-line { flex: 1; height: 3rpx; background: rgba(255,255,255,0.12); margin: 0 10rpx 34rpx; }
.chain-line.passed { background: rgba(226,194,106,0.45); }

/* smoke3 */

/* ===== 三页统一底部按钮 ===== */
.bottom-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 8rpx 24rpx 44rpx;
}
/* ===== 三页统一底部：主按钮=黄色大方块(进下一页) + 分享=同款描边方块（对齐小程序按钮规范） ===== */
.next-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f0d174, #c9a227);
  color: #14181f;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(212, 175, 55, 0.28);
}
.next-btn::after { border: none; }
.next-btn:active { opacity: 0.92; transform: scale(0.99); }
.bottom-actions .next-btn { width: 100%; }
.bottom-actions .ghost-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(226, 194, 106, 0.06);
  border: 1rpx solid rgba(226, 194, 106, 0.28);
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.bottom-actions .ghost-btn:active { opacity: 0.8; }

/* ===== 三页统一节编码（第1/2/3页共用） ===== */
.sec-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(226,194,106,0.22), rgba(226,194,106,0.06));
  border: 1rpx solid rgba(226,194,106,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--accent);
  margin-right: 16rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.bottom-link {
  margin: -8rpx 0 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 14rpx;
}
.bottom-link:active { color: var(--accent); }
