.page {
  padding: 44rpx 24rpx calc(134rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
}

/* 氛围光斑 */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  pointer-events: none;
  z-index: 0;
}
.glow-a {
  width: 420rpx; height: 420rpx;
  top: -120rpx; left: -140rpx;
  background: rgba(212, 175, 55, 0.18);
}
.glow-b {
  width: 360rpx; height: 360rpx;
  top: 80rpx; right: -160rpx;
  background: rgba(125, 176, 255, 0.12);
}

.hero {
  padding: 24rpx 8rpx 30rpx;
  position: relative;
  z-index: 1;
}
.hero-kicker {
  display: inline-block;
  font-size: 20rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1rpx solid rgba(226,194,106,0.3);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}
.hero-title {
  font-family: var(--font-display);
  margin-top: 18rpx;
  font-size: 68rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  background: linear-gradient(120deg, #fff4cf, #e4c66f 45%, #b08d2e);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 8rpx 30rpx rgba(226,194,106,0.25);
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 输入卡 */
.input-area {
  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02)), var(--bg-card-2);
  border: 2rpx solid rgba(255,255,255,0.10);
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 18rpx 44rpx rgba(0,0,0,0.35), inset 0 1rpx 0 rgba(255,255,255,0.06);
  position: relative;
  z-index: 1;
  transition: border-color 0.2s;
}
.input-area:focus-within { border-color: rgba(226,194,106,0.5); }
.input-textarea {
  width: 100%;
  min-height: 170rpx;
  font-size: 30rpx;
  color: var(--text-1);
  line-height: 1.75;
}
.ph { color: var(--text-3); }
.input-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.input-hint { font-size: 22rpx; color: var(--text-3); }
.input-count { font-size: 22rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }

/* 话题 */
.topics { margin-top: 32rpx; position: relative; z-index: 1; }
.topics-label { font-size: 24rpx; color: var(--text-3); margin-bottom: 16rpx; letter-spacing: 1rpx; }
.topic-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.topic-chip {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01)), var(--bg-card);
  border: 1rpx solid rgba(255,255,255,0.09);
  color: var(--text-2);
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.25);
}
.topic-chip:active { border-color: rgba(226,194,106,0.5); color: var(--accent); }
.topic-icon { font-size: 26rpx; margin-right: 8rpx; }
.topic-title { letter-spacing: 1rpx; }

/* 提交 */
.submit-row { margin-top: 44rpx; position: relative; z-index: 1; }

/* 反馈卡 */
.feedback { margin-top: 26rpx; position: relative; z-index: 1; }
.feedback-tip { font-size: 24rpx; color: var(--text-2); margin-bottom: 14rpx; }
.probe {
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--bg-card-2);
  border-left: 4rpx solid var(--accent);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.sources { margin-top: 18rpx; }
.source {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.btn-2row { display: flex; gap: 20rpx; margin-top: 26rpx; }
.btn-2row .btn { flex: 1; }
.btn.ghost {
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  box-shadow: none;
}

.footer-tip {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
}
.reset { color: var(--accent); text-decoration: underline; }

.footer-ver {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-3);
  opacity: 0.7;
  text-align: center;
  padding-bottom: 0;
}

/* ---- 全屏遮罩：扫描环 ---- */
.overlay {
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, #12161f 0%, #0d0f14 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 24vh;
  z-index: 999;
}
.ring {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  border-top-color: var(--accent-strong);
  border-right-color: rgba(226,194,106,0.4);
  animation: spin 1s linear infinite;
  box-shadow: 0 0 34rpx rgba(212,175,55,0.3);
}
@keyframes spin { to { transform: rotate(360deg); } }
.overlay-text {
  margin-top: 40rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 2rpx;
}
.overlay-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---- 分析遮罩：进度条 + 阶段清单 ---- */
.progress-wrap {
  margin-top: 44rpx;
  width: 560rpx;
}
.progress-track {
  height: 12rpx;
  background: var(--bg-card-3);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #b08a2e, #e4c76f, #f3dd9a);
  box-shadow: 0 0 16rpx rgba(226,194,106,0.5);
  transition: width 0.5s ease-out;
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.progress-eta {
  margin-top: 6rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--accent);
}
.stage-list {
  margin-top: 40rpx;
  width: 560rpx;
}
.stage-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 10rpx 0;
}
.stage-item.active { color: var(--text-1); font-weight: 700; }
.stage-item.done { color: var(--text-2); }
.stage-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.16);
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-3);
}
.stage-item.active .stage-dot {
  border-color: var(--accent);
  color: var(--accent);
  animation: pulse 1.2s ease-in-out infinite;
}
.stage-item.done .stage-dot {
  background: rgba(226,194,106,0.35);
  border-color: rgba(226,194,106,0.5);
  color: #14181f;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
