.page {
  padding: 40rpx 24rpx 80rpx;
}
.loading {
  color: var(--text-3);
  text-align: center;
  padding-top: 220rpx;
  line-height: 1.8;
}
.empty-icon { font-size: 64rpx; margin-bottom: 12rpx; }

.share-card {
  background:
    radial-gradient(120% 120% at 85% -20%, rgba(212,175,55,0.22), rgba(255,255,255,0) 55%),
    linear-gradient(160deg, #1f1a10, var(--bg-card) 65%);
  border-color: rgba(226, 194, 106, 0.32);
  padding: 36rpx 32rpx;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(226,194,106,0.2);
}
.brand-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: linear-gradient(135deg, rgba(226,194,106,0.22), rgba(226,194,106,0.06));
  border: 1rpx solid rgba(226,194,106,0.4);
  border-radius: 18rpx;
}
.brand-name {
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  color: var(--accent);
  line-height: 1.3;
}
.brand-sub {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.share-verdict {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.7;
  color: var(--text-1);
  margin-bottom: 28rpx;
  text-shadow: 0 4rpx 24rpx rgba(226,194,106,0.15);
}

.sk-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.sk-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--accent);
}
.sk-block {
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 14rpx;
}
.sk-k {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--accent);
  opacity: 0.9;
  margin-bottom: 4rpx;
}
.sk-v {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.65;
}
.sk-v.dim { color: var(--text-2); }

.share-input {
  font-size: 24rpx;
  color: var(--text-3);
  border-top: 1rpx solid rgba(255,255,255,0.08);
  padding-top: 20rpx;
  margin-top: 8rpx;
  line-height: 1.6;
}
.share-foot {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 26rpx;
}

.actions { margin-top: 36rpx; }
.actions .btn { width: 100%; flex: none; }

.empty {
  text-align: center;
  color: var(--text-2);
  padding-top: 240rpx;
  line-height: 1.9;
}
.empty .btn.ghost {
  margin-top: 40rpx;
  display: inline-block;
  width: 400rpx;
}
.brand-text { flex: 1; }
.skeleton { margin-top: 4rpx; }

/* 分享落地页：报告全貌（8 节） */
.report-steps { margin-top: 8rpx; }
.steps-head {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--accent);
  opacity: 0.9;
  padding: 8rpx 2rpx 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
  margin-top: 20rpx;
  padding-top: 20rpx;
}
.rs-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}
.rs-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.rs-no {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #141017;
  background: linear-gradient(135deg, #e4c66f, #c9a34a);
  border-radius: 12rpx;
}
.rs-label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-1);
}
.rs-row {
  display: flex;
  gap: 14rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid rgba(255,255,255,0.05);
}
.rs-k {
  flex: none;
  width: 170rpx;
  font-size: 22rpx;
  color: var(--accent);
  opacity: 0.9;
  line-height: 1.6;
  padding-top: 2rpx;
}
.rs-v {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}
.share-input {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}
.share-input-k {
  flex: none;
  font-size: 22rpx;
  color: var(--accent);
  opacity: 0.9;
  line-height: 1.6;
  padding-top: 4rpx;
}
.share-input-v {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* ===== 行动方案分享卡（1.0.19 补齐） ===== */
.action-plan { margin-top: 4rpx; }
.ast-step {
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
}
.ast-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.ast-no {
  width: 40rpx; height: 40rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800;
  color: #141017;
  background: linear-gradient(135deg, #e4c66f, #c9a34a);
  border-radius: 12rpx;
}
.ast-label { font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.ast-body { font-size: 24rpx; color: var(--text-2); line-height: 1.65; }
